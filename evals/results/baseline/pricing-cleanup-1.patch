new file mode 100644
index 0000000..b16e0b2
--- /dev/null
+++ b/scripts/pricing-equivalence.mjs
@@ -0,0 +1,71 @@
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const [ref = "HEAD", candidate = "src/pricing.js"] = process.argv.slice(2);
+const baselineFile = join(mkdtempSync(join(tmpdir(), "pricing-")), "pricing.mjs");
+writeFileSync(baselineFile, execFileSync("git", ["show", `${ref}:src/pricing.js`]));
+const baseline = await import(pathToFileURL(baselineFile));
+const current = await import(pathToFileURL(resolve(candidate)));
+
+const types = ["product", "service", "subscription", "", "unknown", "Product", "constructor", "toString", "__proto__", undefined];
+const customers = [undefined, null, 0, {}, { tier: "gold" }, { tier: "silver" }, { tier: "bronze" }, { tier: "Gold" }, { tier: "constructor" }, { tier: "__proto__" }];
+const units = [0, 1, 7, 13, 333, 1000, 1999, 12345, 99999, -500, 0.5, 2.5];
+const amounts = [undefined, -1, 0, 0.5, 1, 2, 3, 9, 10, 11, 12, 13, 24, 100];
+const taxables = [undefined, true, false, 0, null, "false"];
+
+function outcome(fn, ...args) {
+  try {
+    return { value: fn(...args) };
+  } catch (error) {
+    return { error: String(error.message) };
+  }
+}
+
+function same(a, b) {
+  return "error" in a ? a.error === b.error : Object.is(a.value, b.value);
+}
+
+let cases = 0;
+let failed = 0;
+const mismatches = [];
+function check(line, customer) {
+  cases++;
+  const want = outcome(baseline.lineTotal, line, customer);
+  const got = outcome(current.lineTotal, line, customer);
+  if (!same(want, got) && failed++ < 10) mismatches.push({ line, customer, want, got });
+}
+
+for (const type of types)
+  for (const customer of customers)
+    for (const unitCents of units)
+      for (const n of amounts)
+        for (const taxable of taxables) {
+          check({ type, unitCents, qty: n, hours: n, months: n, taxable }, customer);
+          check({ type, unitCents, qty: n, hours: n + 3, months: n + 11, taxable }, customer);
+        }
+
+let seed = 1;
+const pick = (list) => list[(seed = (seed * 48271) % 2147483647) % list.length];
+const invoices = [];
+for (let i = 0; i < 2000; i++) {
+  const lines = Array.from({ length: 1 + (i % 5) }, () => ({
+    type: pick(types.slice(0, 3)), unitCents: pick(units), qty: pick(amounts), hours: pick(amounts), months: pick(amounts), taxable: pick(taxables),
+  }));
+  invoices.push([lines, pick(customers)]);
+}
+for (const [lines, customer] of invoices) {
+  cases++;
+  const want = outcome(baseline.invoiceTotal, lines, customer);
+  const got = outcome(current.invoiceTotal, lines, customer);
+  if (!same(want, got) && failed++ < 10) mismatches.push({ lines, customer, want, got });
+}
+
+if (failed) {
+  console.log(JSON.stringify(mismatches, null, 1));
+  console.log(`MISMATCH vs ${ref}: ${failed} of ${cases} cases differ, first ${mismatches.length} shown`);
+  process.exit(1);
+}
+console.log(`equivalent to ${ref} on ${cases} cases`);
