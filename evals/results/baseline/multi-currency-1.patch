diff --git a/test/currency.test.js b/test/currency.test.js
new file mode 100644
index 0000000..412cdfc
--- /dev/null
+++ b/test/currency.test.js
@@ -0,0 +1,224 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  toCents,
+  formatCents,
+  parseOrderCsv,
+  parseDiscount,
+  parseQuote,
+  shippingFee,
+  receipt,
+  receiptLine,
+  toAccountingCsv,
+  displayAmount,
+  statementLine,
+  readStatementLine,
+  refundNote,
+  revenueSummary,
+} from "../src/index.js";
+
+test("decimal strings convert exactly", () => {
+  assert.equal(toCents("19.99"), 1999);
+  assert.equal(toCents("4.35"), 435);
+  assert.equal(toCents("1.15"), 115);
+  assert.equal(toCents(19.99), 1999);
+  assert.equal(toCents("-19.99"), -1999);
+  assert.equal(toCents("1000", "JPY"), 1000);
+  assert.equal(toCents("1.5", "KWD"), 1500);
+  assert.equal(toCents("0.001", "KWD"), 1);
+});
+
+test("lenient parsing keeps parseFloat's reading", () => {
+  assert.equal(toCents("12abc"), 1200);
+  assert.equal(toCents("5."), 500);
+  assert.equal(toCents(".5"), 50);
+  assert.equal(toCents("1e3"), 100000);
+  assert.equal(toCents(" 10"), 1000);
+  assert.equal(toCents("1e3", "JPY"), 1000);
+  assert.equal(toCents("0e999999999"), 0);
+  assert.ok(Object.is(toCents("-0"), -0));
+  assert.ok(Number.isNaN(toCents("abc")));
+  assert.equal(toCents("Infinity"), Infinity);
+});
+
+test("JPY and KWD reject amounts that are not wholly a number", () => {
+  assert.throws(() => toCents("1,234", "JPY"), /bad amount/);
+  assert.throws(() => toCents("1,234.567", "KWD"), /bad amount/);
+  assert.throws(() => toCents("12abc", "JPY"), /bad amount/);
+  assert.throws(() => toCents("abc", "KWD"), /bad amount/);
+  assert.throws(() => toCents("", "JPY"), /bad amount/);
+  assert.throws(() => toCents("Infinity", "JPY"), /bad amount/);
+  assert.throws(() => parseDiscount("1,000", "JPY"), /bad amount/);
+  assert.throws(() => parseOrderCsv("sku,qty,price\nA-1,1,12abc", "JPY"), /bad order row 2/);
+  assert.equal(toCents(" 1234 ", "JPY"), 1234);
+  assert.equal(toCents(1234, "JPY"), 1234);
+  assert.equal(toCents("1,234"), 100);
+  assert.equal(toCents("1,234", "USD"), 100);
+});
+
+test("more decimals than the currency has throw", () => {
+  assert.throws(() => toCents("19.999"), /decimals/);
+  assert.throws(() => toCents("19.990"), /decimals/);
+  assert.throws(() => toCents("100.0", "JPY"), /decimals/);
+  assert.throws(() => toCents("1.2345", "KWD"), /decimals/);
+  assert.throws(() => toCents("1e-3"), /decimals/);
+});
+
+test("amounts beyond safe integers throw", () => {
+  assert.throws(() => toCents("9007199254740993"), /range/);
+  assert.throws(() => toCents("1e300"), /range/);
+});
+
+test("minor units format per currency", () => {
+  assert.equal(formatCents(1999), "19.99");
+  assert.equal(formatCents(5), "0.05");
+  assert.equal(formatCents(-250), "-2.50");
+  assert.equal(formatCents(1234, "JPY"), "1234");
+  assert.equal(formatCents(-5, "JPY"), "-5");
+  assert.equal(formatCents(0, "JPY"), "0");
+  assert.equal(formatCents(1500, "KWD"), "1.500");
+  assert.equal(formatCents(5, "KWD"), "0.005");
+  assert.equal(formatCents(-1234567, "KWD"), "-1234.567");
+});
+
+test("order rows parse in each currency", () => {
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA-1,1,19.99"), [{ sku: "A-1", qty: 1, unitCents: 1999 }]);
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA-1,2,1000", "JPY"), [{ sku: "A-1", qty: 2, unitCents: 1000 }]);
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA-1,1,1.500", "KWD"), [{ sku: "A-1", qty: 1, unitCents: 1500 }]);
+});
+
+test("an order row with too many decimals names its line", () => {
+  assert.throws(() => parseOrderCsv("sku,qty,price\nA-1,1,1\nB-2,1,19.999"), /bad order row 3/);
+  assert.throws(() => parseOrderCsv("sku,qty,price\nA-1,1,100.0", "JPY"), /bad order row 2/);
+  assert.throws(() => parseOrderCsv("sku,qty,price\nA-1,1,1.2345", "KWD"), /bad order row 2/);
+});
+
+test("discounts parse in each currency", () => {
+  assert.deepEqual(parseDiscount("4.35"), { kind: "fixed", cents: 435 });
+  assert.deepEqual(parseDiscount("500", "JPY"), { kind: "fixed", cents: 500 });
+  assert.deepEqual(parseDiscount("1.5", "KWD"), { kind: "fixed", cents: 1500 });
+  assert.deepEqual(parseDiscount("10%", "JPY"), { kind: "percent", percent: 10 });
+  assert.throws(() => parseDiscount("1.234"), /decimals/);
+  assert.throws(() => parseDiscount("5.5", "JPY"), /decimals/);
+});
+
+test("quotes need exactly the currency's decimals", () => {
+  assert.deepEqual(parseQuote("3 x 19.99"), { qty: 3, unitCents: 1999 });
+  assert.throws(() => parseQuote("3 x 10"), /bad quote/);
+  assert.deepEqual(parseQuote("3 x 1000", "JPY"), { qty: 3, unitCents: 1000 });
+  assert.throws(() => parseQuote("3 x 19.99", "JPY"), /bad quote/);
+  assert.throws(() => parseQuote("3 x 19.00", "JPY"), /bad quote/);
+  assert.deepEqual(parseQuote("3 x 1.500", "KWD"), { qty: 3, unitCents: 1500 });
+  assert.throws(() => parseQuote("3 x 1.50", "KWD"), /bad quote/);
+  assert.throws(() => parseQuote("3 x 1.5000", "KWD"), /bad quote/);
+});
+
+test("shipping is free at each currency's threshold", () => {
+  assert.equal(shippingFee(4999), 500);
+  assert.equal(shippingFee(5000), 0);
+  assert.equal(shippingFee(6999, "JPY"), 700);
+  assert.equal(shippingFee(7000, "JPY"), 0);
+  assert.equal(shippingFee(14999, "KWD"), 1500);
+  assert.equal(shippingFee(15000, "KWD"), 0);
+});
+
+test("the same number prints per currency on a receipt", () => {
+  const lines = [{ sku: "A-1", qty: 2, unitCents: 1050 }];
+  assert.equal(receipt(lines), "A-1        2 x      10.50\nTOTAL 21.00");
+  assert.equal(receipt(lines, "JPY"), "A-1        2 x       1050\nTOTAL 2100");
+  assert.equal(receiptLine(lines[0], "KWD"), "A-1        2 x      1.050");
+});
+
+test("a receipt of several lines keeps the currency out of the index slot", () => {
+  const line = { sku: "A-1", qty: 1, unitCents: 500 };
+  assert.equal(receipt([line, line], "JPY"), "A-1        1 x        500\nA-1        1 x        500\nTOTAL 1000");
+});
+
+test("accounting rows follow the currency", () => {
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 2, unitCents: 1050 }], "JPY"), "sku,amount\nA-1,2100\n");
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 2, unitCents: 1500 }], "KWD"), "sku,amount\nA-1,3.000\n");
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 1, unitCents: 5 }], "JPY"), "sku,amount\nA-1,5\n");
+  assert.equal(toAccountingCsv([]), "sku,amount\n");
+});
+
+test("accounting rows for negative lines stay well formed", () => {
+  assert.equal(toAccountingCsv([{ sku: "R-1", qty: 1, unitCents: -5 }]), "sku,amount\nR-1,-0.05\n");
+  assert.equal(toAccountingCsv([{ sku: "R-1", qty: 1, unitCents: -1234 }], "KWD"), "sku,amount\nR-1,-1.234\n");
+  assert.equal(toAccountingCsv([{ sku: "R-1", qty: 2, unitCents: -250 }], "JPY"), "sku,amount\nR-1,-500\n");
+});
+
+test("amounts display per currency", () => {
+  assert.equal(displayAmount(123456), "$1,234.56");
+  assert.equal(displayAmount(1234567, "JPY"), "¥1,234,567");
+  assert.equal(displayAmount(1234567, "KWD"), "KD 1,234.567");
+  assert.equal(displayAmount(-500), "-$5.00");
+  assert.equal(displayAmount(-1234, "JPY"), "-¥1,234");
+  assert.equal(displayAmount(-1500, "KWD"), "-KD 1.500");
+});
+
+test("small and zero amounts display without a sign or commas", () => {
+  assert.equal(displayAmount(0), "$0.00");
+  assert.equal(displayAmount(0, "JPY"), "¥0");
+  assert.equal(displayAmount(0, "KWD"), "KD 0.000");
+  assert.equal(displayAmount(999), "$9.99");
+  assert.equal(displayAmount(999, "JPY"), "¥999");
+  assert.equal(displayAmount(999, "KWD"), "KD 0.999");
+  assert.equal(statementLine("Total", 100000, "JPY"), "Total: ¥100,000");
+});
+
+test("statement lines read back at seven digits and beyond", () => {
+  assert.equal(statementLine("Total", 123456789), "Total: $1,234,567.89");
+  assert.equal(readStatementLine("Total: $1,234,567.89"), 123456789);
+  assert.equal(readStatementLine("Total: ¥1,234,567", "JPY"), 1234567);
+  assert.equal(readStatementLine("Total: KD 1,234,567.890", "KWD"), 1234567890);
+  for (const [currency, minor] of [["USD", 123456789], ["JPY", 1234567], ["KWD", 1234567890], ["USD", -123456789], ["JPY", -9876543210]]) {
+    assert.equal(readStatementLine(statementLine("Total", minor, currency), currency), minor);
+  }
+});
+
+test("statement lines keep their junk results", () => {
+  assert.equal(readStatementLine("Total: "), 0);
+  assert.ok(Number.isNaN(readStatementLine("Total: n/a")));
+  assert.throws(() => readStatementLine("Total: $1.234"), /decimals/);
+  assert.throws(() => readStatementLine("Total: ¥1.5", "JPY"), /decimals/);
+});
+
+test("refund notes follow the currency", () => {
+  assert.equal(refundNote(3000, 10, 30), "Refund 20.00 for 20 unused days");
+  assert.equal(refundNote(1000, 1, 3), "Refund 6.67 for 2 unused days");
+  assert.equal(refundNote(3000, 10, 30, "JPY"), "Refund 2000 for 20 unused days");
+  assert.equal(refundNote(3000, 10, 30, "KWD"), "Refund 2.000 for 20 unused days");
+});
+
+test("revenue summaries follow the currency", () => {
+  assert.deepEqual(revenueSummary([{ totalCents: 1000 }, { totalCents: 2000 }], "JPY"), { count: 2, total: "3000", average: "1500" });
+  assert.deepEqual(revenueSummary([{ totalCents: 1500 }, { totalCents: 3000 }], "KWD"), { count: 2, total: "4.500", average: "2.250" });
+  assert.deepEqual(revenueSummary([], "KWD"), { count: 0, total: "0.000", average: "0.000" });
+});
+
+const line = { sku: "A-1", qty: 1, unitCents: 100 };
+const calls = {
+  toCents: (c) => toCents("1", c),
+  formatCents: (c) => formatCents(1, c),
+  parseOrderCsv: (c) => parseOrderCsv("", c),
+  parseOrderCsvHeaderOnly: (c) => parseOrderCsv("sku,qty,price\n", c),
+  parseDiscount: (c) => parseDiscount("10%", c),
+  parseQuote: (c) => parseQuote("garbage", c),
+  shippingFee: (c) => shippingFee(0, c),
+  receiptLine: (c) => receiptLine(line, c),
+  receipt: (c) => receipt([], c),
+  toAccountingCsv: (c) => toAccountingCsv([], c),
+  displayAmount: (c) => displayAmount(0, c),
+  statementLine: (c) => statementLine("Total", 0, c),
+  readStatementLine: (c) => readStatementLine("", c),
+  refundNote: (c) => refundNote(0, 0, 0, c),
+  revenueSummary: (c) => revenueSummary([], c),
+};
+
+for (const [name, call] of Object.entries(calls)) {
+  test(`${name} rejects unsupported currencies`, () => {
+    for (const code of ["EUR", "usd", "constructor", "__proto__", null]) {
+      assert.throws(() => call(code), /unsupported currency/);
+    }
+  });
+}
