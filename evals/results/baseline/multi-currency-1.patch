diff --git a/src/money.js b/src/money.js
index 0fc432b..3e3c2b5 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,9 +1,30 @@
-export function toCents(amount) {
-  return Math.floor(parseFloat(amount) * 100);
+import { currencyInfo } from "./currency.js";
+
+export function toCents(amount, currency = "USD") {
+  const { decimals, lenientParsing } = currencyInfo(currency);
+  const value = parseFloat(amount);
+  const text = String(amount).trimEnd();
+  const [number, sign, whole, fraction = "", exponent = "0"] = /^\s*([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?/.exec(text);
+  if (!lenientParsing && (!Number.isFinite(value) || number !== text)) throw new Error(`bad amount for ${currency}: ${amount}`);
+  if (!Number.isFinite(value)) return value;
+  const places = fraction.length - Number(exponent);
+  if (places > decimals) throw new Error(`too many decimals for ${currency}: ${amount}`);
+  // capped so "0e999999999" is 0 instead of a RangeError from repeat
+  const minor = Number(`${sign}${whole}${fraction}${"0".repeat(Math.min(decimals - places, 20))}`);
+  if (!Number.isSafeInteger(minor)) throw new Error(`amount out of range: ${amount}`);
+  return minor;
 }
 
-export function formatCents(cents) {
+export function formatCents(cents, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
   const sign = cents < 0 ? "-" : "";
   const abs = Math.abs(cents);
-  return `${sign}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
+  const unit = 10 ** decimals;
+  const fraction = decimals === 0 ? "" : `.${String(abs % unit).padStart(decimals, "0")}`;
+  return `${sign}${Math.floor(abs / unit)}${fraction}`;
+}
+
+export function fixedAmount(minor, currency) {
+  const { decimals } = currencyInfo(currency);
+  return (minor / 10 ** decimals).toFixed(decimals);
 }
