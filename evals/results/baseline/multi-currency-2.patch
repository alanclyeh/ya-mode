+  assert.equal(formatCents(1500, "JPY"), "1500");
+  assert.equal(formatCents(0, "JPY"), "0");
+  assert.equal(formatCents(-5, "JPY"), "-5");
+  assert.equal(formatCents(1500, "KWD"), "1.500");
+  assert.equal(formatCents(5, "KWD"), "0.005");
