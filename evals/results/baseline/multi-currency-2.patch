+  assert.equal(displayAmount(5, "KWD"), "KD 0.005");
+  assert.equal(displayAmount(-5000, "KWD"), "-KD 5.000");
+  assert.equal(statementLine("Total", 1234567, "JPY"), "Total: ¥1,234,567");
+});
+
+test("statement lines read back in every currency", () => {
+  for (const currency of ["USD", "JPY", "KWD"]) {
+    for (const cents of [0, 5, 123456, 1234567, 123456789, -5, -1234567]) {
+      assert.equal(readStatementLine(statementLine("Total", cents, currency), currency), cents);
+    }
+  }
+  assert.equal(readStatementLine("Total: ¥1,234,567", "JPY"), 1234567);
+  assert.equal(readStatementLine("Total: $1,234,567.89"), 123456789);
+});
+
+test("odd statement text keeps Number's reading", () => {
+  assert.equal(readStatementLine("Total: "), 0);
+  assert.equal(readStatementLine("Total: n/a"), NaN);
+});
+
+test("refund notes follow the currency", () => {
+  assert.equal(refundNote(3000, 10, 30, "JPY"), "Refund 2000 for 20 unused days");
+  assert.equal(refundNote(1000, 1, 3, "JPY"), "Refund 667 for 2 unused days");
+  assert.equal(refundNote(3000, 10, 30, "KWD"), "Refund 2.000 for 20 unused days");
+  assert.equal(refundNote(1000, 1, 3, "KWD"), "Refund 0.667 for 2 unused days");
+  assert.equal(refundNote(1000, 1, 3), "Refund 6.67 for 2 unused days");
+  assert.throws(() => refundNote(3000, 40, 30, "KWD"), /bad billing period/);
+});
