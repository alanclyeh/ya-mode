diff --git a/test/currency.test.js b/test/currency.test.js
new file mode 100644
index 0000000..1bdbdaf
--- /dev/null
+++ b/test/currency.test.js
@@ -0,0 +1,45 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import * as billing from "../src/index.js";
+
+const {
+  toCents,
+  formatCents,
+  parseOrderCsv,
+  parseDiscount,
+  parseQuote,
+  shippingFee,
+  receiptLine,
+  receipt,
+  toAccountingCsv,
+  displayAmount,
+  statementLine,
+  readStatementLine,
+  refundNote,
+  revenueSummary,
+} = billing;
+
+const calls = {
+  toCents: (c) => toCents("1", c),
+  formatCents: (c) => formatCents(1, c),
+  parseOrderCsv: (c) => parseOrderCsv("", c),
+  parseDiscount: (c) => parseDiscount("10%", c),
+  parseQuote: (c) => parseQuote("not a quote", c),
+  shippingFee: (c) => shippingFee(0, c),
+  receiptLine: (c) => receiptLine({ sku: "A", qty: 1, unitCents: 1 }, c),
+  receipt: (c) => receipt([], c),
+  toAccountingCsv: (c) => toAccountingCsv([], c),
+  displayAmount: (c) => displayAmount(0, c),
+  statementLine: (c) => statementLine("Total", 0, c),
+  readStatementLine: (c) => readStatementLine("Total: 0", c),
+  refundNote: (c) => refundNote(100, 0, 0, c),
+  revenueSummary: (c) => revenueSummary([], c),
+};
+
+for (const [name, call] of Object.entries(calls)) {
+  test(`${name} rejects an unsupported currency`, () => {
+    for (const bad of ["EUR", "jpy", "constructor", "__proto__", null, 0]) {
+      assert.throws(() => call(bad), new RegExp(`unsupported currency: ${bad}`));
+    }
+  });
+}
