+// A Map, so "constructor" and "__proto__" are not currencies.
+const currencies = new Map([
+  ["USD", { decimals: 2, symbol: "$", freeShippingAt: 5000, shippingFee: 500 }],
+  ["JPY", { decimals: 0, symbol: "¥", freeShippingAt: 7000, shippingFee: 700 }],
+  ["KWD", { decimals: 3, symbol: "KD ", freeShippingAt: 15000, shippingFee: 1500 }],
+]);
+
+export function currencyInfo(code) {
+  const info = currencies.get(code);
+  if (!info) throw new Error(`unsupported currency: ${code}`);
+  return info;
+}
