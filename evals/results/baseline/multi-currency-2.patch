--- a/src/money.js
+++ b/src/money.js
@@ -1,9 +1,28 @@
-export function toCents(amount) {
-  return Math.floor(parseFloat(amount) * 100);
+import { currencyInfo } from "./currency.js";
+
+export function toCents(amount, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
+  const approx = parseFloat(amount);
+  if (!Number.isFinite(approx)) return approx;
+  const [, sign, whole, fraction, exponent = "0"] = /^([+-]?)(\d*)\.?(\d*)(?:[eE]([+-]?\d+))?/.exec(
+    String(amount).trimStart(),
+  );
+  const shift = decimals + Number(exponent) - fraction.length;
+  if (shift < 0) throw new Error(`too many decimal places for ${currency}: ${amount}`);
+  // Shifting the decimal text avoids float multiplication, which turns 4.35 into 434.99.
+  return Number(`${sign}${whole}${fraction}e${shift}`);
 }
 
-export function formatCents(cents) {
+export function formatCents(cents, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
+  const unit = 10 ** decimals;
   const sign = cents < 0 ? "-" : "";
   const abs = Math.abs(cents);
-  return `${sign}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
+  const whole = `${sign}${Math.floor(abs / unit)}`;
+  return decimals === 0 ? whole : `${whole}.${String(abs % unit).padStart(decimals, "0")}`;
+}
+
+export function decimalText(minor, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
+  return (minor / 10 ** decimals).toFixed(decimals);
 }
