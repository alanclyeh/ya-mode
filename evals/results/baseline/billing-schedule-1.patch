new file mode 100644
index 0000000..047ab79
--- /dev/null
+++ b/src/schedule.js
@@ -0,0 +1,51 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+const STEPS = {
+  weekly: { days: 7 },
+  monthly: { months: 1 },
+  yearly: { months: 12 },
+};
+
+function parseDate(text) {
+  const match = typeof text === "string" && /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!match) throw new Error(`bad date: ${text}`);
+  const [year, month, day] = match.slice(1).map(Number);
+  if (month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month)) throw new Error(`bad date: ${text}`);
+  return { year, month, day };
+}
+
+// Date.UTC maps years 0-99 to 1900-1999, so set the year explicitly.
+function utcDate(year, month, day) {
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day);
+  return date;
+}
+
+function daysInMonth(year, month) {
+  return utcDate(year, month + 1, 0).getUTCDate();
+}
+
+function formatDate(year, month, day) {
+  return `${String(year).padStart(4, "0")}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
+}
+
+// Each date is offset from the start, not from the previous charge, so a
+// customer clamped to Feb 28 goes back to the 31st in March.
+function shift(start, step, n) {
+  if (step.days) {
+    const date = new Date(utcDate(start.year, start.month, start.day).getTime() + n * step.days * DAY_MS);
+    return formatDate(date.getUTCFullYear(), date.getUTCMonth() + 1, date.getUTCDate());
+  }
+  const monthIndex = start.month - 1 + n * step.months;
+  const year = start.year + Math.floor(monthIndex / 12);
+  const month = (monthIndex % 12) + 1;
+  return formatDate(year, month, Math.min(start.day, daysInMonth(year, month)));
+}
+
+export function nextBillingDates(startDate, interval, count) {
+  const start = parseDate(startDate);
+  const step = Object.hasOwn(STEPS, interval) ? STEPS[interval] : null;
+  if (!step) throw new Error(`bad interval: ${interval}`);
+  if (!Number.isInteger(count) || count < 0) throw new Error(`bad count: ${count}`);
+  return Array.from({ length: count }, (_, i) => shift(start, step, i + 1));
+}
diff --git a/test/schedule.test.js b/test/schedule.test.js
new file mode 100644
index 0000000..cd65e79
--- /dev/null
+++ b/test/schedule.test.js
@@ -0,0 +1,37 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { nextBillingDates } from "../src/index.js";
+
+test("weekly dates cross month and year ends", () => {
+  assert.deepEqual(nextBillingDates("2026-12-24", "weekly", 3), ["2026-12-31", "2027-01-07", "2027-01-14"]);
+});
+
+test("month-end signups clamp to short months and return to the 31st", () => {
+  assert.deepEqual(nextBillingDates("2026-01-31", "monthly", 4), ["2026-02-28", "2026-03-31", "2026-04-30", "2026-05-31"]);
+  assert.deepEqual(nextBillingDates("2027-12-31", "monthly", 3), ["2028-01-31", "2028-02-29", "2028-03-31"]);
+});
+
+test("leap-day yearly signups bill Feb 28 in common years and Feb 29 in leap years", () => {
+  assert.deepEqual(nextBillingDates("2024-02-29", "yearly", 4), ["2025-02-28", "2026-02-28", "2027-02-28", "2028-02-29"]);
+});
+
+test("zero count returns no dates", () => {
+  assert.deepEqual(nextBillingDates("2026-01-15", "monthly", 0), []);
+});
+
+test("invalid arguments throw", () => {
+  for (const date of ["2026-02-30", "2025-02-29", "2026-13-01", "2026-00-10", "2026-1-5", "2026/01/05", "", undefined]) {
+    assert.throws(() => nextBillingDates(date, "monthly", 1), /bad date/);
+  }
+  for (const interval of ["daily", "Monthly", "toString", undefined]) {
+    assert.throws(() => nextBillingDates("2026-01-15", interval, 1), /bad interval/);
+  }
+  for (const count of [-1, 1.5, "3", NaN, Infinity, undefined]) {
+    assert.throws(() => nextBillingDates("2026-01-15", "monthly", count), /bad count/);
+  }
+});
+
+test("years below 100 are not read as 19xx", () => {
+  assert.deepEqual(nextBillingDates("0099-12-30", "weekly", 1), ["0100-01-06"]);
+  assert.deepEqual(nextBillingDates("0000-01-31", "monthly", 1), ["0000-02-29"]);
+});
