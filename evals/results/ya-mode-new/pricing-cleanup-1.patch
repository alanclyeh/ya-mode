+const TAX_RATE = 0.08;
+const BULK_MIN_QTY = 10;
+const BULK_RATE = 0.05;
+const LONG_TERM_MIN_MONTHS = 12;
+const LONG_TERM_RATE = 0.15;
+
+// Every tier lists every line type. A missing line type silently means no discount, so write 0 when that is the intent.
+const TIER_RATES = new Map([
+  ["gold", { product: 0.1, service: 0.1, subscription: 0.1 }],
+  ["silver", { product: 0.05, service: 0.05, subscription: 0 }],
+]);
+
+// discountRates lists rates in the order they apply. Each one rounds to whole cents before the next.
+const LINE_TYPES = new Map([
+  [
+    "product",
+    {
+      unitsField: "qty",
+      taxed: true,
+      discountRates: (line, tierRate) => [tierRate, line.qty >= BULK_MIN_QTY ? BULK_RATE : 0],
+    },
+  ],
+  [
+    "service",
+    {
+      unitsField: "hours",
+      taxed: false,
+      discountRates: (line, tierRate) => [tierRate],
+    },
+  ],
+  [
+    "subscription",
+    {
+      unitsField: "months",
+      taxed: true,
+      discountRates: (line, tierRate) => [line.months >= LONG_TERM_MIN_MONTHS ? LONG_TERM_RATE : tierRate],
+    },
+  ],
+]);
+
 export function lineTotal(line, customer) {
-  let total = 0;
-  if (line.type === "product") {
-    if (customer && customer.tier === "gold") {
-      total = line.unitCents * line.qty;
-      total = total - Math.round(total * 0.1);
-      if (line.qty >= 10) {
-        total = total - Math.round(total * 0.05);
-      }
-    } else if (customer && customer.tier === "silver") {
-      total = line.unitCents * line.qty;
-      total = total - Math.round(total * 0.05);
-      if (line.qty >= 10) {
-        total = total - Math.round(total * 0.05);
-      }
-    } else {
-      total = line.unitCents * line.qty;
-      if (line.qty >= 10) {
-        total = total - Math.round(total * 0.05);
-      }
-    }
-    if (line.taxable !== false) {
-      total = total + Math.round(total * 0.08);
-    }
-  } else if (line.type === "service") {
-    if (customer && customer.tier === "gold") {
-      total = line.unitCents * line.hours;
-      total = total - Math.round(total * 0.1);
-    } else if (customer && customer.tier === "silver") {
-      total = line.unitCents * line.hours;
-      total = total - Math.round(total * 0.05);
-    } else {
-      total = line.unitCents * line.hours;
-    }
-  } else if (line.type === "subscription") {
-    total = line.unitCents * line.months;
-    if (line.months >= 12) {
-      total = total - Math.round(total * 0.15);
-    } else if (customer && customer.tier === "gold") {
-      total = total - Math.round(total * 0.1);
-    }
-    if (line.taxable !== false) {
-      total = total + Math.round(total * 0.08);
-    }
-  } else {
+  const lineType = LINE_TYPES.get(line.type);
+  if (!lineType) {
     throw new Error("unknown line type: " + line.type);
   }
+  let total = line.unitCents * line[lineType.unitsField];
+  const tierRate = TIER_RATES.get(customer?.tier)?.[line.type];
+  for (const rate of lineType.discountRates(line, tierRate)) {
+    if (rate) {
+      total = total - Math.round(total * rate);
+    }
+  }
+  if (lineType.taxed && line.taxable !== false) {
