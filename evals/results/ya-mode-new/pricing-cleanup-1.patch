 }
 
diff --git a/test/pricing.test.js b/test/pricing.test.js
index e421a14..23b4245 100644
--- a/test/pricing.test.js
+++ b/test/pricing.test.js
@@ -17,3 +17,61 @@ test("invoice sums its lines", () => {
   ];
   assert.equal(invoiceTotal(lines), 11000);
 });
+
+const GOLD = { tier: "gold" };
+const SILVER = { tier: "silver" };
+
+const cases = [
+  ["product, no tier, taxed", { type: "product", unitCents: 1000, qty: 1 }, undefined, 1080],
+  ["product, gold, taxed", { type: "product", unitCents: 1000, qty: 1 }, GOLD, 972],
+  ["product, silver, taxed", { type: "product", unitCents: 1000, qty: 1 }, SILVER, 1026],
+  ["product just under the bulk threshold", { type: "product", unitCents: 1000, qty: 9 }, undefined, 9720],
+  ["product bulk, no tier", { type: "product", unitCents: 1000, qty: 10 }, undefined, 10260],
+  ["product bulk stacks on gold", { type: "product", unitCents: 1000, qty: 10 }, GOLD, 9234],
+  ["product bulk stacks on silver", { type: "product", unitCents: 1000, qty: 10 }, SILVER, 9747],
+  ["product bulk, untaxed", { type: "product", unitCents: 1000, qty: 10, taxable: false }, undefined, 9500],
+  ["tier discount applies before bulk", { type: "product", unitCents: 1, qty: 10, taxable: false }, GOLD, 9],
+  ["each discount rounds on its own", { type: "product", unitCents: 10, qty: 10, taxable: false }, GOLD, 85],
+  ["service, no tier", { type: "service", unitCents: 5000, hours: 2 }, undefined, 10000],
+  ["service, gold", { type: "service", unitCents: 5000, hours: 2 }, GOLD, 9000],
+  ["service, silver", { type: "service", unitCents: 5000, hours: 2 }, SILVER, 9500],
+  ["service has no bulk discount", { type: "service", unitCents: 1000, hours: 10 }, undefined, 10000],
+  ["service is never taxed", { type: "service", unitCents: 1000, hours: 1, taxable: true }, undefined, 1000],
+  ["subscription under a year, no tier", { type: "subscription", unitCents: 1000, months: 11 }, undefined, 11880],
+  ["subscription under a year, gold", { type: "subscription", unitCents: 1000, months: 11 }, GOLD, 10692],
+  ["subscription under a year, silver gets nothing", { type: "subscription", unitCents: 1000, months: 11 }, SILVER, 11880],
+  ["subscription for a year, no tier", { type: "subscription", unitCents: 1000, months: 12 }, undefined, 11016],
+  ["subscription for a year does not stack with gold", { type: "subscription", unitCents: 1000, months: 12 }, GOLD, 11016],
+  ["subscription for a year, untaxed", { type: "subscription", unitCents: 1000, months: 12, taxable: false }, undefined, 10200],
+  ["tax rounds up to a whole cent", { type: "product", unitCents: 1, qty: 7 }, undefined, 8],
+  ["tax rounds down to a whole cent", { type: "product", unitCents: 1, qty: 1 }, undefined, 1],
+  ["only taxable: false skips tax", { type: "product", unitCents: 1000, qty: 1, taxable: null }, undefined, 1080],
+  ["a null customer pays full price", { type: "product", unitCents: 1000, qty: 1 }, null, 1080],
+  ["an unknown tier pays full price", { type: "product", unitCents: 1000, qty: 1 }, { tier: "platinum" }, 1080],
+  ["a tier named after an Object member pays full price", { type: "product", unitCents: 1000, qty: 1 }, { tier: "constructor" }, 1080],
+  ["a tier that only stringifies to a known tier pays full price", { type: "product", unitCents: 1000, qty: 1 }, { tier: ["gold"] }, 1080],
+];
+
+for (const [name, line, customer, expected] of cases) {
+  test(name, () => {
+    assert.equal(lineTotal(line, customer), expected);
+  });
+}
+
+for (const type of ["bundle", "constructor", "toString", undefined]) {
+  test(`line type ${type} is rejected`, () => {
+    assert.throws(() => lineTotal({ type, unitCents: 1000, qty: 1 }), { message: `unknown line type: ${type}` });
+  });
+}
+
+test("a line type that only stringifies to a known type is rejected", () => {
+  assert.throws(() => lineTotal({ type: ["product"], unitCents: 1000, qty: 1 }), /unknown line type/);
+});
+
+test("invoice passes the customer to every line", () => {
+  const lines = [
+    { type: "product", unitCents: 1000, qty: 1, taxable: false },
+    { type: "service", unitCents: 5000, hours: 2 },
+  ];
+  assert.equal(invoiceTotal(lines, GOLD), 9900);
+});
