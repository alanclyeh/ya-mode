diff --git a/test/currency.test.js b/test/currency.test.js
new file mode 100644
index 0000000..464ff7f
--- /dev/null
+++ b/test/currency.test.js
@@ -0,0 +1,189 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  toCents,
+  formatCents,
+  parseOrderCsv,
+  parseDiscount,
+  applyDiscount,
+  parseQuote,
+  shippingFee,
+  receiptLine,
+  receipt,
+  toAccountingCsv,
+  displayAmount,
+  statementLine,
+  readStatementLine,
+  refundNote,
+  revenueSummary,
+} from "../src/index.js";
+
+test("parsing has no floating point error", () => {
+  assert.equal(toCents("19.99"), 1999);
+  assert.equal(toCents("4.35"), 435);
+  assert.equal(toCents("1.15"), 115);
+  assert.equal(toCents("-19.99"), -1999);
+  assert.equal(toCents("1.001", "KWD"), 1001);
+  assert.equal(toCents("8.325", "KWD"), 8325);
+  assert.equal(toCents("1234567", "JPY"), 1234567);
+  for (let cents = 0; cents < 20000; cents++) {
+    assert.equal(toCents(formatCents(cents)), cents);
+    assert.equal(toCents(formatCents(cents, "KWD"), "KWD"), cents);
+  }
+});
+
+test("parsing keeps number input and lenient text", () => {
+  assert.equal(toCents(19.99), 1999);
+  assert.equal(toCents(" 2.5 "), 250);
+  assert.equal(toCents("12abc"), 1200);
+  assert.equal(toCents("1e3"), 100000);
+  assert.equal(toCents(".5"), 50);
+  assert.equal(toCents("5."), 500);
+  assert.equal(toCents("1.5e1"), 1500);
+  assert.equal(toCents("100e-3"), 10);
+  assert.equal(toCents("1.50e-1"), 15);
+  assert.equal(toCents("1.50e1", "JPY"), 15);
+  assert.equal(toCents("Infinity"), Infinity);
+  assert.ok(Number.isNaN(toCents("abc")));
+});
+
+test("parsing rejects more decimals than the currency allows", () => {
+  assert.throws(() => toCents("19.999"), /too many decimals/);
+  assert.throws(() => toCents("19.99", "JPY"), /too many decimals/);
+  assert.throws(() => toCents("1.2345", "KWD"), /too many decimals/);
+  assert.throws(() => toCents("1e-3"), /too many decimals/);
+  assert.throws(() => toCents("19.990"), /too many decimals/);
+  assert.throws(() => toCents("100.0", "JPY"), /too many decimals/);
+});
+
+test("parsing rejects amounts an integer cannot hold exactly", () => {
+  assert.throws(() => toCents("90071992547409.93"), /out of range/);
+});
+
+test("unsigned output follows the currency's decimals", () => {
+  assert.equal(formatCents(1999, "JPY"), "1999");
+  assert.equal(formatCents(-250, "JPY"), "-250");
+  assert.equal(formatCents(1234567, "KWD"), "1234.567");
+  assert.equal(formatCents(5, "KWD"), "0.005");
+  assert.equal(formatCents(-50, "KWD"), "-0.050");
+});
+
+test("signed display uses the currency's symbol, sign first", () => {
+  assert.equal(displayAmount(123456), "$1,234.56");
+  assert.equal(displayAmount(1234567, "JPY"), "¥1,234,567");
+  assert.equal(displayAmount(1234567, "KWD"), "KD 1,234.567");
+  assert.equal(displayAmount(-1234567, "JPY"), "-¥1,234,567");
+  assert.equal(displayAmount(-1234567, "KWD"), "-KD 1,234.567");
+  assert.equal(displayAmount(999, "JPY"), "¥999");
+  assert.equal(displayAmount(1234567890, "KWD"), "KD 1,234,567.890");
+});
+
+test("statement lines read back in every currency", () => {
+  for (const [currency, cents] of [
+    ["USD", 123456789],
+    ["USD", -500],
+    ["JPY", 1234567],
+    ["JPY", -1234567],
+    ["KWD", 1234567890],
+    ["KWD", -1234567],
+  ]) {
+    assert.equal(readStatementLine(statementLine("Net: Total", cents, currency), currency), cents);
+  }
+  assert.equal(statementLine("Total", 1234567, "KWD"), "Total: KD 1,234.567");
+  assert.equal(readStatementLine("Total: "), 0);
+  assert.ok(Number.isNaN(readStatementLine("Total: abc")));
+  assert.ok(Number.isNaN(readStatementLine("Total: $5.00", "JPY")));
+  assert.throws(() => readStatementLine("Total: $5.555"), /too many decimals/);
+});
+
+test("order rows parse in the order's currency", () => {
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA-1,2,1050\n", "JPY"), [{ sku: "A-1", qty: 2, unitCents: 1050 }]);
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA-1,2,1.050\n", "KWD"), [{ sku: "A-1", qty: 2, unitCents: 1050 }]);
+  assert.throws(() => parseOrderCsv("sku,qty,price\nA-1,2,19.99\n", "JPY"), /row 2.*too many decimals/);
+});
+
+test("fixed discounts parse in the currency, percent discounts round to its minor unit", () => {
+  assert.deepEqual(parseDiscount("4.35"), { kind: "fixed", cents: 435 });
+  assert.deepEqual(parseDiscount("500", "JPY"), { kind: "fixed", cents: 500 });
+  assert.deepEqual(parseDiscount("1.500", "KWD"), { kind: "fixed", cents: 1500 });
+  assert.throws(() => parseDiscount("4.35", "JPY"), /too many decimals/);
+  assert.equal(applyDiscount(1005, parseDiscount("10%", "JPY"), "JPY"), 904);
+  assert.equal(applyDiscount(300, parseDiscount("500", "JPY"), "JPY"), 0);
+});
+
+test("quotes carry exactly the currency's decimals", () => {
+  assert.deepEqual(parseQuote("3 x 19.99"), { qty: 3, unitCents: 1999 });
+  assert.deepEqual(parseQuote("3 x 1999", "JPY"), { qty: 3, unitCents: 1999 });
+  assert.deepEqual(parseQuote("3 x 1.999", "KWD"), { qty: 3, unitCents: 1999 });
+  assert.throws(() => parseQuote("3 x 19.99", "JPY"), /bad quote/);
+  assert.throws(() => parseQuote("3 x 19.999"), /bad quote/);
+  assert.throws(() => parseQuote("3 x 1.99", "KWD"), /bad quote/);
+});
+
+test("shipping follows each currency's threshold and fee", () => {
+  for (const [currency, freeOver, fee] of [
+    ["USD", 5000, 500],
+    ["JPY", 7000, 700],
+    ["KWD", 15000, 1500],
+  ]) {
+    assert.equal(shippingFee(freeOver - 1, currency), fee);
+    assert.equal(shippingFee(freeOver, currency), 0);
+  }
+});
+
+test("receipts do not share formatted prices across currencies", () => {
+  const lines = [{ sku: "A-1", qty: 2, unitCents: 1050 }];
+  assert.equal(receipt(lines), "A-1        2 x      10.50\nTOTAL 21.00");
+  assert.equal(receipt(lines, "JPY"), "A-1        2 x       1050\nTOTAL 2100");
+  assert.equal(receipt(lines, "KWD"), "A-1        2 x      1.050\nTOTAL 2.100");
+  assert.equal(receiptLine(lines[0]), "A-1        2 x      10.50");
+});
+
+test("accounting rows follow the currency's decimals", () => {
+  const lines = [{ sku: "A-1", qty: 2, unitCents: 1050 }];
+  assert.equal(toAccountingCsv(lines, "JPY"), "sku,amount\nA-1,2100\n");
+  assert.equal(toAccountingCsv(lines, "KWD"), "sku,amount\nA-1,2.100\n");
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 1, unitCents: 5 }], "KWD"), "sku,amount\nA-1,0.005\n");
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 1, unitCents: -50 }], "KWD"), "sku,amount\nA-1,-0.050\n");
+});
+
+test("USD accounting rows keep their original text below zero", () => {
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 1, unitCents: -50 }]), "sku,amount\nA-1,-.50\n");
+  assert.equal(toAccountingCsv([{ sku: "A-1", qty: 1, unitCents: -5 }]), "sku,amount\nA-1,0.-5\n");
+});
+
+test("refund notes and revenue summaries follow the currency's decimals", () => {
+  assert.equal(refundNote(3000, 10, 30, "JPY"), "Refund 2000 for 20 unused days");
+  assert.equal(refundNote(3000, 10, 30, "KWD"), "Refund 2.000 for 20 unused days");
+  assert.equal(refundNote(1000, 1, 3, "JPY"), "Refund 667 for 2 unused days");
+  assert.equal(refundNote(1000, 1, 3, "KWD"), "Refund 0.667 for 2 unused days");
+  const invoices = [{ totalCents: 1000 }, { totalCents: 2002 }];
+  assert.deepEqual(revenueSummary(invoices, "JPY"), { count: 2, total: "3002", average: "1501" });
+  assert.deepEqual(revenueSummary(invoices, "KWD"), { count: 2, total: "3.002", average: "1.501" });
+});
+
+test("every currency-aware function rejects an unsupported currency, even with empty input", () => {
+  const calls = [
+    (c) => toCents("1", c),
+    (c) => toCents("abc", c),
+    (c) => formatCents(1, c),
+    (c) => parseOrderCsv("sku,qty,price\n", c),
+    (c) => parseDiscount("10%", c),
+    (c) => applyDiscount(100, { kind: "fixed", cents: 1 }, c),
+    (c) => parseQuote("1 x 1.00", c),
+    (c) => shippingFee(1, c),
+    (c) => receiptLine({ sku: "A", qty: 1, unitCents: 1 }, c),
+    (c) => receipt([], c),
+    (c) => toAccountingCsv([], c),
+    (c) => displayAmount(1, c),
+    (c) => statementLine("x", 1, c),
+    (c) => readStatementLine("x: $1.00", c),
+    (c) => refundNote(100, 0, 1, c),
+    (c) => revenueSummary([], c),
+  ];
+  for (const call of calls) {
+    for (const currency of ["EUR", "jpy", "constructor", "__proto__", null]) {
+      assert.throws(() => call(currency), /unsupported currency/);
+    }
+  }
+});
