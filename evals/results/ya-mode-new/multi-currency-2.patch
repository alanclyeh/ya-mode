+// Amounts in this table are integers in the currency's minor unit.
+const CURRENCIES = new Map([
+  ["USD", { decimals: 2, symbol: "$", freeOver: 5000, flatFee: 500 }],
+  ["JPY", { decimals: 0, symbol: "¥", freeOver: 7000, flatFee: 700 }],
+  ["KWD", { decimals: 3, symbol: "KD ", freeOver: 15000, flatFee: 1500 }],
+]);
+
+export function currencyInfo(currency) {
+  const info = CURRENCIES.get(currency);
+  if (!info) throw new Error(`unsupported currency: ${currency}`);
+  return info;
+}
