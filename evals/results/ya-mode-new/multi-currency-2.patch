-export function toCents(amount) {
-  return Math.floor(parseFloat(amount) * 100);
+import { currencyInfo } from "./currency.js";
+
+// The part of the text parseFloat reads: sign, whole digits, fraction digits, exponent.
+const NUMBER_PREFIX = /^\s*([+-]?)(\d*)\.?(\d*)(?:e([+-]?\d+))?/i;
+
+export function toCents(amount, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
+  const value = parseFloat(amount);
+  if (!Number.isFinite(value)) return value;
+  const [, sign, whole, fraction, exponent] = NUMBER_PREFIX.exec(amount);
+  const shift = decimals + Number(exponent ?? 0) - fraction.length;
+  // Plain text stays digits until it is a whole number, so no binary fraction is involved.
+  const cents = Number(`${sign}${whole}${fraction}e${shift}`);
+  // Exponent text has no literal decimals to count, so its value decides.
+  const fits = exponent === undefined ? shift >= 0 : Number.isInteger(cents);
+  if (!fits) throw new Error(`too many decimals for ${currency}: ${amount}`);
+  if (!Number.isSafeInteger(cents)) throw new Error(`amount out of range: ${amount}`);
+  return cents;
 }
 
-export function formatCents(cents) {
+export function formatCents(cents, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
   const sign = cents < 0 ? "-" : "";
   const abs = Math.abs(cents);
-  return `${sign}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
+  const unit = 10 ** decimals;
+  const whole = Math.floor(abs / unit);
+  if (decimals === 0) return `${sign}${whole}`;
+  return `${sign}${whole}.${String(abs % unit).padStart(decimals, "0")}`;
+}
+
+// For amounts that may be fractional, such as averages and prorated refunds.
+export function roundedAmount(cents, currency) {
+  const { decimals } = currencyInfo(currency);
+  return (cents / 10 ** decimals).toFixed(decimals);
 }
