+// Amounts are integers in each currency's minor unit, so shipping values here are too.
+const CURRENCIES = new Map([
+  ["USD", { decimals: 2, symbol: "$", freeShippingOver: 5000, shippingFee: 500 }],
+  ["JPY", { decimals: 0, symbol: "¥", freeShippingOver: 7000, shippingFee: 700 }],
+  ["KWD", { decimals: 3, symbol: "KD ", freeShippingOver: 15000, shippingFee: 1500 }],
+]);
+
+export function currencyInfo(currency) {
+  const info = CURRENCIES.get(currency);
+  if (!info) throw new Error(`unsupported currency: ${currency}`);
+  return info;
+}
