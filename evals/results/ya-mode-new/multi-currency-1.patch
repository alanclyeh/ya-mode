diff --git a/test/currency-output.test.js b/test/currency-output.test.js
new file mode 100644
index 0000000..4ee86a3
--- /dev/null
+++ b/test/currency-output.test.js
@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  formatCents, shippingFee, receiptLine, receipt, toAccountingCsv, displayAmount, statementLine, readStatementLine, refundNote, revenueSummary,
+} from "../src/index.js";
+
+test("plain output follows the currency's decimals", () => {
+  assert.equal(formatCents(1234567, "JPY"), "1234567");
+  assert.equal(formatCents(-5, "JPY"), "-5");
+  assert.equal(formatCents(1234567, "KWD"), "1234.567");
+  assert.equal(formatCents(5, "KWD"), "0.005");
+  assert.equal(formatCents(-1050, "KWD"), "-1.050");
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 2, unitCents: 980 }], "JPY"), "sku,amount\nA,1960\n");
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 1, unitCents: 5 }], "JPY"), "sku,amount\nA,5\n");
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 1, unitCents: 5 }], "KWD"), "sku,amount\nA,0.005\n");
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 1, unitCents: 5 }]), "sku,amount\nA,0.05\n");
+  assert.equal(refundNote(3000, 10, 30, "JPY"), "Refund 2000 for 20 unused days");
+  assert.equal(refundNote(1000, 10, 30, "KWD"), "Refund 0.667 for 20 unused days");
+  assert.deepEqual(revenueSummary([{ totalCents: 1000 }, { totalCents: 2002 }], "JPY"), { count: 2, total: "3002", average: "1501" });
+  assert.deepEqual(revenueSummary([{ totalCents: 1000 }, { totalCents: 2002 }], "KWD"), { count: 2, total: "3.002", average: "1.501" });
+  assert.deepEqual(revenueSummary([], "JPY"), { count: 0, total: "0", average: "0" });
+});
+
+test("negative accounting amounts below one major unit keep their sign in front", () => {
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 1, unitCents: -5 }]), "sku,amount\nA,-0.05\n");
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 1, unitCents: -5 }], "KWD"), "sku,amount\nA,-0.005\n");
+  assert.equal(toAccountingCsv([{ sku: "A", qty: 1, unitCents: -5 }], "JPY"), "sku,amount\nA,-5\n");
+});
+
+test("symbol display per currency", () => {
+  assert.equal(displayAmount(123456), "$1,234.56");
+  assert.equal(displayAmount(123456789), "$1,234,567.89");
+  assert.equal(displayAmount(1234567, "JPY"), "¥1,234,567");
+  assert.equal(displayAmount(999, "JPY"), "¥999");
+  assert.equal(displayAmount(1000, "JPY"), "¥1,000");
+  assert.equal(displayAmount(1234567, "KWD"), "KD 1,234.567");
+  assert.equal(displayAmount(5, "KWD"), "KD 0.005");
+  assert.equal(displayAmount(-1234567, "JPY"), "-¥1,234,567");
+  assert.equal(displayAmount(-1234567, "KWD"), "-KD 1,234.567");
+  assert.equal(statementLine("Total", 1234567, "KWD"), "Total: KD 1,234.567");
+});
+
+test("statement lines read back in every currency", () => {
+  const cases = [["USD", 123456789], ["USD", -123456789], ["USD", 1999], ["JPY", 1234567], ["JPY", -1234567], ["JPY", 0], ["KWD", 1234567890], ["KWD", -1234567], ["KWD", 1]];
+  for (const [currency, cents] of cases) {
+    assert.equal(readStatementLine(statementLine("Net: due", cents, currency), currency), cents);
+  }
+});
+
+test("statement lines that hold no amount stay as they were", () => {
+  assert.equal(readStatementLine("Total: abc"), NaN);
+  assert.equal(readStatementLine("Total: 12abc"), NaN);
+  assert.equal(readStatementLine("Total: "), 0);
+});
+
+test("the same amount in two currencies keeps its own receipt text", () => {
+  const lines = [{ sku: "A-1", qty: 2, unitCents: 1050 }];
+  assert.equal(receipt(lines), "A-1        2 x      10.50\nTOTAL 21.00");
+  assert.equal(receipt(lines, "JPY"), "A-1        2 x       1050\nTOTAL 2100");
+  assert.equal(receipt(lines, "KWD"), "A-1        2 x      1.050\nTOTAL 2.100");
+  assert.equal(receiptLine(lines[0]), "A-1        2 x      10.50");
+});
+
+test("free shipping starts at each currency's threshold", () => {
+  assert.equal(shippingFee(4999), 500);
+  assert.equal(shippingFee(5000), 0);
+  assert.equal(shippingFee(6999, "JPY"), 700);
+  assert.equal(shippingFee(7000, "JPY"), 0);
+  assert.equal(shippingFee(14999, "KWD"), 1500);
+  assert.equal(shippingFee(15000, "KWD"), 0);
+});
+
+test("a statement line with too many decimals throws", () => {
+  assert.throws(() => readStatementLine("Total: $19.999"), /too many decimals/);
+});
+
+test("unsupported currencies throw, even when nothing else would touch the currency", () => {
+  const calls = [
+    (c) => shippingFee(1, c),
+    (c) => receiptLine({ sku: "A", qty: 1, unitCents: 1 }, c),
+    (c) => receipt([], c),
+    (c) => toAccountingCsv([], c),
+    (c) => displayAmount(1, c),
+    (c) => statementLine("Total", 1, c),
+    (c) => readStatementLine("Total: $1.00", c),
+    (c) => refundNote(1, 0, 1, c),
+    (c) => revenueSummary([], c),
+  ];
+  for (const call of calls) {
+    for (const code of ["EUR", "usd", "", null, "constructor", "__proto__"]) {
+      assert.throws(() => call(code), /unsupported currency/);
+    }
+  }
+});
diff --git a/test/currency-parsing.test.js b/test/currency-parsing.test.js
new file mode 100644
index 0000000..8b871eb
--- /dev/null
+++ b/test/currency-parsing.test.js
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { toCents, formatCents, parseOrderCsv, parseDiscount, applyDiscount, parseQuote } from "../src/index.js";
+
+test("amounts that are inexact in binary parse exactly", () => {
+  assert.equal(toCents("19.99"), 1999);
+  assert.equal(toCents("4.35"), 435);
+  assert.equal(toCents("1.15"), 115);
+  assert.equal(toCents("-19.99"), -1999);
+  assert.equal(toCents(19.99), 1999);
+  assert.equal(toCents("1.001", "KWD"), 1001);
+  assert.equal(toCents("4.35", "KWD"), 4350);
+  assert.equal(parseDiscount("4.35").cents, 435);
+  assert.equal(parseQuote("3 x 19.99").unitCents, 1999);
+  assert.equal(parseOrderCsv("sku,qty,price\nA,1,19.99")[0].unitCents, 1999);
+});
+
+test("toCents accepts every number form parseFloat does", () => {
+  assert.equal(toCents(" 12.34"), 1234);
+  assert.equal(toCents("\t7"), 700);
+  assert.equal(toCents("+5"), 500);
+  assert.equal(toCents(".5"), 50);
+  assert.equal(toCents("5."), 500);
+  assert.equal(toCents("-.5"), -50);
+  assert.equal(toCents("1e3"), 100000);
+  assert.equal(toCents("1E2"), 10000);
+  assert.equal(toCents("1e+2"), 10000);
+  assert.equal(toCents("1.5e1"), 1500);
+  assert.equal(toCents("1500e-2"), 1500);
+  assert.equal(toCents("12abc"), 1200);
+  assert.equal(toCents("1.2.3"), 120);
+  assert.equal(toCents(2.5), 250);
+  assert.equal(toCents("-0"), -0);
+  assert.equal(toCents("abc"), NaN);
+  assert.equal(toCents(""), NaN);
+  assert.equal(toCents("Infinity"), Infinity);
+  assert.equal(toCents("-Infinity"), -Infinity);
+  assert.equal(toCents("1e400"), Infinity);
+  assert.throws(() => toCents("1e-3"), /too many decimals/);
+});
+
+test("parsing scales by the currency", () => {
+  assert.equal(toCents("1234", "JPY"), 1234);
+  assert.equal(toCents("1.5", "KWD"), 1500);
+  assert.equal(toCents("1e3", "JPY"), 1000);
+  assert.deepEqual(parseDiscount("500", "JPY"), { kind: "fixed", cents: 500 });
+  assert.deepEqual(parseDiscount("1.250", "KWD"), { kind: "fixed", cents: 1250 });
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA,2,980", "JPY"), [{ sku: "A", qty: 2, unitCents: 980 }]);
+  assert.deepEqual(parseOrderCsv("sku,qty,price\nA,2,1.250", "KWD"), [{ sku: "A", qty: 2, unitCents: 1250 }]);
+});
+
+test("too many decimals throw", () => {
+  assert.throws(() => toCents("19.99", "JPY"), /too many decimals/);
+  assert.throws(() => toCents("19.999"), /too many decimals/);
+  assert.throws(() => toCents("1.2345", "KWD"), /too many decimals/);
+  assert.throws(() => parseDiscount("19.99", "JPY"), /too many decimals/);
+  assert.throws(() => parseOrderCsv("sku,qty,price\nA,1,19.999"), /row 2.*too many decimals/);
+});
+
+test("quotes carry exactly the currency's decimals", () => {
+  assert.deepEqual(parseQuote("3 x 1980", "JPY"), { qty: 3, unitCents: 1980 });
+  assert.deepEqual(parseQuote("3 x 1.250", "KWD"), { qty: 3, unitCents: 1250 });
+  assert.throws(() => parseQuote("3 x 19.99", "JPY"), /bad quote/);
+  assert.throws(() => parseQuote("3 x 1.25", "KWD"), /bad quote/);
+  assert.throws(() => parseQuote("3 x 1.250"), /bad quote/);
+});
+
+test("a fixed discount and its total share the minor unit", () => {
+  assert.equal(applyDiscount(2000, parseDiscount("500", "JPY")), 1500);
+  assert.equal(applyDiscount(2000, parseDiscount("0.500", "KWD")), 1500);
+});
+
+test("unsupported currencies throw, even when nothing else would touch the currency", () => {
+  const calls = [
+    (c) => toCents("1", c),
+    (c) => toCents("abc", c),
+    (c) => formatCents(1, c),
+    (c) => parseOrderCsv("sku,qty,price\n", c),
+    (c) => parseDiscount("10%", c),
+    (c) => parseDiscount("1", c),
+    (c) => parseQuote("1 x 1.00", c),
+  ];
+  for (const call of calls) {
+    for (const code of ["EUR", "usd", "", null, "constructor", "__proto__"]) {
+      assert.throws(() => call(code), /unsupported currency/);
+    }
+  }
+});
