+// Reads a sales quote such as "3 x 19.99". The price carries exactly the currency's decimals.
+export function parseQuote(text, currency = "USD") {
+  const { decimals } = currencyInfo(currency);
+  const price = decimals === 0 ? "\\d+" : `\\d+\\.\\d{${decimals}}`;
+  const match = new RegExp(`^\\s*(\\d+)\\s*x\\s*(${price})\\s*$`).exec(text);
   if (!match) throw new Error(`bad quote: ${text}`);
-  return { qty: Number(match[1]), unitCents: toCents(match[2]) };
+  return { qty: Number(match[1]), unitCents: toCents(match[2], currency) };
 }
